{
  "name": "ice-delivery-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_APP_MODE=demo vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_APP_MODE=demo tsc -b && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android-apk.mjs",
    "storage:migrate-catalog-images": "node scripts/migrate-catalog-images-to-r2.mjs",
    "storage:refresh-catalog-cache": "node scripts/refresh-catalog-image-cache.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:ui",
    "test:postgres-concurrency": "node tests/financial-concurrency.postgres.mjs",
    "test:ui": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^6.0.1",
    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.864.0",
    "@capacitor/cli": "^8.5.0",
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "ws": "8.21.1"
  }
}
